- name: 🇭🇰 香港节点
  type: select
  include-all: true
  filter: (?i)港|hk|hongkong|hong kong
- name: 🇯🇵 日本节点
  type: select
  include-all: true
  filter: (?i)日|jp|japan
- name: 🇹🇼 台湾节点
  type: select
  include-all: true
  filter: (?i)台|tw|taiwan
- name: 🇺🇲 美国节点
  type: select
  include-all: true
  filter: (?i)美|us|unitedstates|united states
- name: 🇬🇧 英国节点
  type: select
  include-all: true
  filter: (?=.*(英国|UK|(?i)Britain|British))^((?!(港|台|日|韩|美|新|欧)).)*$
- name: 🇫🇷 法国节点
  type: select
  include-all: true
  filter: (?i)fr|france|french|paris|法国
- name: 🔯 香港故转
  type: fallback
  include-all: true
  interval: 300
  filter: (?=.*(港|HK|(?i)Hong))^((?!(台|日|韩|新|深|美)).)*$
- name: 🔯 美国故转
  type: fallback
  include-all: true
  interval: 300
  filter: (?=.*(美|US|(?i)States|America))^((?!(港|台|日|韩|新)).)*$
- name: 🔯 日本故转
  type: fallback
  include-all: true
  interval: 300
  filter: (?=.*(日|JP|(?i)Japan))^((?!(港|台|韩|新|美)).)*$
- name: ♻️ 香港智能
  type: url-test
  include-all: true
  interval: 300
  filter: (?=.*(港|HK|(?i)Hong))^((?!(台|日|韩|新|深|美)).)*$
- name: ♻️ 日本智能
  type: url-test
  include-all: true
  interval: 300
  filter: (?=.*(日|JP|(?i)Japan))^((?!(港|台|韩|新|美)).)*$
- name: ♻️ 台湾自动选择
  type: url-test
  include-all: true
  interval: 300
  filter: (?i)台|tw|taiwan
- name: ♻️ 美国智能
  type: url-test
  include-all: true
  interval: 300
  filter: (?=.*(美|US|(?i)States|America))^((?!(港|台|日|韩|新)).)*$
- name: ♻️ 加坡智能
  type: url-test
  include-all: true
  interval: 300
  filter: (?=.*(新|SG|(?i)SG|Singapore))^((?!(港|台|日|韩|美)).)*$
- name: ♻️ 欧洲智能
  type: url-test
  include-all: true
  interval: 300
  filter: (?i)great britain|france|italy|kazakhstan|germany|kingdom|turkey|switzerland|netherlands|英国|法国|德国|意大利|荷兰|土耳其|瑞士
- name: ♻️ 自动选择
  type: url-test
  include-all: true
  interval: 300
  filter: ^((?!(直连|Static-IP|剩余流量|套餐到期|Traffic Reset|Expire Date)).)*$
- name: 🌐 全部节点
  type: select
  include-all: true
  filter: ^((?!(直连|Static-IP|剩余流量|套餐到期|Traffic Reset|Expire Date)).)*$
